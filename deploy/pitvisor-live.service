[Unit]
Description=Pitvisor Replay Service (recorded F1 sessions + SSE)
After=network.target

[Service]
User=disinteg
Group=disinteg
WorkingDirectory=/home/disinteg/pitvisor/backend
Environment="PATH=/home/disinteg/pitvisor/venv/bin"
Environment="PITVISOR_CACHE_DIR=/home/disinteg/pitvisor/doc_cache"
Environment="PITVISOR_LIVE_RECORDING_DIR=/home/disinteg/pitvisor/backend/recordings"
Environment="PITVISOR_TRACK_CACHE_DIR=/home/disinteg/pitvisor/track_cache"
Environment="PITVISOR_MAX_REPLAY_SESSIONS=3"
# ── Tunable knobs (defaults shown; uncomment + edit to override) ──
# Environment="PITVISOR_LIVE_STREAM_INTERVAL=0.33"
# Environment="PITVISOR_LIVE_TEL_INTERVAL=0.25"
# Environment="PITVISOR_LIVE_KEEPALIVE_INTERVAL=15.0"
# Environment="PITVISOR_LIVE_TEL_BUFFER_LEN=180"
# Environment="PITVISOR_LIVE_RACE_CONTROL_KEEP=50"
# Environment="PITVISOR_LIVE_REPLAY_SEEK_SEC=0"
# Environment="PITVISOR_LIVE_REPLAY_SKIP_TO_START=1"
# Environment="PITVISOR_DOWNLOAD_LIMIT=6"
ExecStart=/home/disinteg/pitvisor/venv/bin/gunicorn \
    --workers 1 \
    --threads 32 \
    --worker-class gthread \
    --timeout 0 \
    --graceful-timeout 10 \
    --bind 127.0.0.1:5101 \
    live_main:app
Restart=always
RestartSec=5

# A replay session holds its own LiveState plus the fully parsed recording
# in memory (~800 MB per 100 MB of JSONL). Sessions are capped by
# PITVISOR_MAX_REPLAY_SESSIONS; this ceiling is the backstop.
CPUQuota=60%
MemoryMax=5G
MemoryHigh=4G

[Install]
WantedBy=multi-user.target
