[Unit]
Description=Pitvisor Live Timing Service (F1 SignalR + SSE)
After=network.target

[Service]
User=disinteg
Group=disinteg
WorkingDirectory=/home/disinteg/pitvisor/backend
Environment="PATH=/home/disinteg/pitvisor/venv/bin"
Environment="PITVISOR_CACHE_DIR=/home/disinteg/pitvisor/doc_cache"
ExecStart=/home/disinteg/pitvisor/venv/bin/gunicorn \
    --workers 1 \
    --threads 32 \
    --worker-class gthread \
    --preload \
    --timeout 0 \
    --graceful-timeout 10 \
    --bind 127.0.0.1:5101 \
    live_main:app
Restart=always
RestartSec=5

# Resource limits to coexist with MC server and main pitvisor backend
CPUQuota=40%
MemoryMax=1G
MemoryHigh=768M

[Install]
WantedBy=multi-user.target
