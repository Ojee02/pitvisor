[Unit]
Description=Pitvisor Live Timing Service (F1 SignalR + SSE)
After=network.target

[Service]
User=disinteg
Group=disinteg
WorkingDirectory=/home/disinteg/pitvisor/backend
Environment="PATH=/home/disinteg/pitvisor/venv/bin"
Environment="PITVISOR_CACHE_DIR=/home/disinteg/pitvisor/doc_cache"
Environment="PITVISOR_LIVE_RECORDING_DIR=/home/disinteg/pitvisor/backend/recordings"
# ── Tunable knobs (defaults shown; uncomment + edit to override) ──
# Environment="PITVISOR_LIVE_STREAM_INTERVAL=1.0"
# Environment="PITVISOR_LIVE_TEL_INTERVAL=0.25"
# Environment="PITVISOR_LIVE_KEEPALIVE_INTERVAL=15.0"
# Environment="PITVISOR_LIVE_PRE_WINDOW_MINUTES=15"
# Environment="PITVISOR_LIVE_POST_WINDOW_HOURS=3"
# Environment="PITVISOR_LIVE_POLL_INTERVAL=60"
# Environment="PITVISOR_LIVE_CLIENT_TIMEOUT=120"
# Environment="PITVISOR_LIVE_TEL_BUFFER_LEN=180"
# Environment="PITVISOR_LIVE_RACE_CONTROL_KEEP=50"
# ── Replay mode (dev only — leave unset in production) ──
# Environment="PITVISOR_LIVE_REPLAY=/home/disinteg/pitvisor/backend/recordings/2025_Singapore_Race.jsonl"
# Environment="PITVISOR_LIVE_REPLAY_SPEED=10"
# Environment="PITVISOR_LIVE_REPLAY_LOOP=1"
ExecStart=/home/disinteg/pitvisor/venv/bin/gunicorn \
    --workers 1 \
    --threads 32 \
    --worker-class gthread \
    --preload \
    --timeout 0 \
    --graceful-timeout 10 \
    --bind 127.0.0.1:5101 \
    live_main:app
Restart=always
RestartSec=5

# Resource limits to coexist with MC server and main pitvisor backend.
# Replay sessions hold a per-session LiveState (~20 MB) plus the full
# parsed records list during loading (~800 MB per 100 MB JSONL), so the
# old 768 MB/1 GB ceiling throttled the feeder thread and made load()
# take 10+ minutes. Raised to comfortable levels for a few concurrent
# replay sessions.
CPUQuota=60%
MemoryMax=5G
MemoryHigh=4G

[Install]
WantedBy=multi-user.target
